# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Gmail OAuth ---
# For local dev you can instead drop credentials.json in the project root and
# run `npm run auth`. For headless/CI runs, set these three from that flow:
GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxx
GMAIL_REFRESH_TOKEN=xxxxxxxx

# --- Behavior (optional) ---
# GMAIL_QUERY=from:googlegroups.com is:unread newer_than:1d
# MAX_MESSAGES=10
# MARK_READ=false
# DRY_RUN=true

# --- Your reply signature (optional; overrides config.js default) ---
# SIGNATURE="Dr. Jane Doe, MD\nExample Psychiatry\n555-1234 | jane@example.com"
